{
  "name": "ai-image-playground",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@image-playground/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check . && bun run scripts/check-private-boundary.ts",
    "format": "biome format --write .",
    "test:deps:up": "./scripts/infra-compose.sh up",
    "test:deps:down": "./scripts/infra-compose.sh down",
    "test:deps:status": "./scripts/infra-compose.sh status",
    "db:verify": "bun run packages/db/src/verify-schema.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "turbo": "^2.5.0"
  }
}
