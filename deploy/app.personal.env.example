# Copy to a repository-external directory such as
# ~/.config/ai-image-playground/apps/image-playground-personal/app.env.
# Replace every replace-* value and chmod 600 the result. Never commit the real file.

APP_IMAGE=ai-image-playground:local
INFRA_NETWORK_NAME=image-playground-infra
EDGE_NETWORK_NAME=image-playground-edge

# PostgreSQL roles are provisioned with `scripts/infra-compose.sh provision`.
# Admin credentials belong to the SELECT-only role.
APP_DATABASE_URL=postgresql://replace-personal-app-user:replace-personal-app-password@postgres:5432/replace-personal-database
ADMIN_DATABASE_URL=postgresql://replace-personal-admin-user:replace-personal-admin-password@postgres:5432/replace-personal-database

S3_ENDPOINT=http://minio:9000
S3_BUCKET=replace-personal-bucket
S3_ACCESS_KEY_ID=replace-personal-access-key
S3_SECRET_ACCESS_KEY=replace-personal-secret-key

INTERNAL_API_TOKEN=replace-personal-internal-service-token
CORS_ALLOWED_ORIGINS=https://personal.example.com

ADMIN_PASSWORD=replace-personal-operator-password
ADMIN_COOKIE_SECRET=replace-personal-cookie-secret-at-least-32-characters

# The same static build is used by every deployment. Empty means same-origin nginx proxying.
BFF_ENABLED=true
BFF_BASE_URL=

# This file may be absent. If present, malformed configuration prevents BFF startup.
OPERATOR_CONFIG_FILE=/run/operator/operator-config.json

# Provider keys are examples only. Keep only variables referenced by operator-config.json or channels.json.
OPENAI_API_KEY=replace-personal-openai-key
GEMINI_API_KEY=replace-personal-gemini-key
