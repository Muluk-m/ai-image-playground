# Copy to a repository-external directory such as
# ~/.config/ai-image-playground/apps/image-playground-personal/app.env.
# Replace every replace-* value and chmod 600 the result. Never commit the real file.

APP_IMAGE=ai-image-playground:local
INFRA_NETWORK_NAME=image-playground-infra
EDGE_NETWORK_NAME=image-playground-edge

# PostgreSQL roles are provisioned with `scripts/infra-compose.sh provision`.
# The schema-owner credential lives only in the sibling migrate.env.
# APP_DATABASE_URL is DML-only; Admin credentials belong to the SELECT-only role.
# The same application role writes tasks and billing rows in one transaction. Do not split
# billing into a second DB user; default privileges provision DML on private migration tables.
APP_DATABASE_URL=postgresql://replace-personal-app-user:replace-personal-app-password@postgres:5432/replace-personal-database
ADMIN_DATABASE_URL=postgresql://replace-personal-admin-user:replace-personal-admin-password@postgres:5432/replace-personal-database

# These three values must match MINIO_PERSONAL_* in the infrastructure environment file.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=replace-with-personal-deployment-bucket
S3_ACCESS_KEY_ID=replace-with-personal-access-key
S3_SECRET_ACCESS_KEY=replace-with-personal-secret-key

INTERNAL_API_TOKEN=replace-personal-internal-service-token
CORS_ALLOWED_ORIGINS=https://personal.example.com

# Worker health is based on successful queue polls. Keep the stale threshold at least three polls.
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEALTH_STALE_AFTER_MS=10000

ADMIN_PASSWORD=replace-personal-operator-password
ADMIN_COOKIE_SECRET=replace-personal-cookie-secret-at-least-32-characters

# The same static build is used by every deployment. Empty means same-origin nginx proxying.
BFF_ENABLED=true
BFF_BASE_URL=

# This file may be absent. If present, malformed configuration prevents BFF startup.
OPERATOR_CONFIG_FILE=/run/operator/operator-config.json

# Standard OpenAI/Gemini channels use one shared gateway. Do not include /v1 in this URL.
UPSTREAM_BASE_URL=https://replace-with-personal-upstream-gateway
UPSTREAM_API_KEY=replace-personal-upstream-key
# Optional provider-specific gateway credentials override UPSTREAM_API_KEY.
UPSTREAM_OPENAI_API_KEY=
UPSTREAM_GEMINI_API_KEY=

# Channel secrets must match auth.secretRef in channels.json. Agnes uses its value directly.
OPENAI_API_KEY=replace-personal-openai-key
GEMINI_API_KEY=replace-personal-gemini-key
AGNES_API_KEY=replace-personal-agnes-key
