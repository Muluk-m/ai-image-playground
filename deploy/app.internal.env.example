# Copy to a repository-external directory such as
# ~/.config/ai-image-playground/apps/image-playground-internal/app.env.
# Replace every replace-* value and chmod 600 the result. Never commit the real file.

APP_IMAGE=ai-image-playground:local
INFRA_NETWORK_NAME=image-playground-infra

# PostgreSQL roles are provisioned with `scripts/infra-compose.sh provision`.
# The schema-owner credential lives only in the sibling migrate.env.
# APP_DATABASE_URL is DML-only; Admin credentials belong to the SELECT-only role.
# The same application role writes tasks and billing rows in one transaction.
APP_DATABASE_URL=postgresql://replace-internal-app-user:replace-internal-app-password@postgres:5432/replace-internal-database
# The daily pg-backup sidecar reuses this SELECT-only credential for pg_dump.
ADMIN_DATABASE_URL=postgresql://replace-internal-admin-user:replace-internal-admin-password@postgres:5432/replace-internal-database

# Cloudflare R2, S3-compatible. Leave the region unset: R2 accepts only `auto`.
S3_ENDPOINT=https://replace-with-company-account-id.r2.cloudflarestorage.com
S3_BUCKET=ai-images
# This bucket is shared with other workloads, so every object of this deployment lives here.
S3_KEY_PREFIX=image-playground/
S3_ACCESS_KEY_ID=replace-with-internal-r2-access-key
S3_SECRET_ACCESS_KEY=replace-with-internal-r2-secret-key

# 灵感库封面与参考图放公开桶（同一套 R2 凭据，另一个 bucket）。两个都空 = 后台不能上传，
# 已导入的外链条目照常发布。BASE_URL 是这个桶对外的只读域名，不带尾斜杠。
PUBLIC_ASSET_BUCKET=replace-with-public-assets-bucket
PUBLIC_ASSET_BASE_URL=https://replace-with-public-assets-domain

INTERNAL_API_TOKEN=replace-internal-internal-service-token
CORS_ALLOWED_ORIGINS=https://image-playground.example.com

# Both apply only to the reverse-proxy layout of README options 2 and 3, where nginx fronts the
# stack instead of cloudflared. Uncomment there; leave commented for the tunnel.
# CLIENT_IP_SOURCE=x-forwarded-for
# APP_INGRESS_MODE=full

# Worker health is based on successful queue polls. Keep the stale threshold at least three polls.
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEALTH_STALE_AFTER_MS=10000
# How long SIGTERM lets inflight generations finish before they are aborted and requeued. Raising
# it also requires raising the worker `stop_grace_period` in deploy/compose.app.yaml.
WORKER_DRAIN_TIMEOUT_MS=55000

ADMIN_PASSWORD=replace-internal-operator-password
ADMIN_COOKIE_SECRET=replace-internal-cookie-secret-at-least-32-characters
# Set empty when Admin's frontend is hosted separately; delete the line to keep serving dist
# from the image.
ADMIN_DIST_DIR=

# Optional Google login for Admin. Configured when the client id, the secret and at least one
# allowed address are all set; password login is then refused and ADMIN_PASSWORD may stay empty.
# OAuth callback lands on the Admin API; completion returns to the separately hosted frontend.
ADMIN_PUBLIC_ORIGIN=https://internal-admin-api.example.com
ADMIN_FRONTEND_ORIGIN=https://internal-admin.example.com
ADMIN_CORS_ALLOWED_ORIGINS=https://internal-admin.example.com
# Register <ADMIN_PUBLIC_ORIGIN>/api/auth/google/callback as an authorized redirect URI.
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_ALLOWED_EMAILS=

# Read only by the optional nginx `web` service. The Cloudflare Pages bundle gets these two
# values from scripts/pages-deploy.sh instead.
BFF_ENABLED=true
BFF_BASE_URL=https://image-api.example.com

# Optional Google login. The button appears on the login page only when both values are set.
# New subjects are provisioned as new accounts; they never merge into a password account with the
# same address, and they need `accounts:self-register` to stay enabled.
# AUTH_PUBLIC_ORIGIN is the origin registered as the provider redirect base; leave it unset only
# when the BFF sees its own public host. AUTH_FRONTEND_ORIGIN defaults to the first CORS origin.
AUTH_PUBLIC_ORIGIN=https://image-api.example.com
AUTH_FRONTEND_ORIGIN=https://image-playground.example.com
# Redirect URI to register: <AUTH_PUBLIC_ORIGIN>/api/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# This file may be absent. If present, malformed configuration prevents BFF startup.
OPERATOR_CONFIG_FILE=/run/operator/operator-config.json

# Standard OpenAI/Gemini channels use one shared gateway. Do not include /v1 in this URL.
UPSTREAM_BASE_URL=https://replace-with-internal-upstream-gateway
UPSTREAM_API_KEY=replace-internal-upstream-key
# Optional provider-specific gateway credentials override UPSTREAM_API_KEY.
UPSTREAM_OPENAI_API_KEY=
UPSTREAM_GEMINI_API_KEY=
# Set only when the gateway is sub2api with async image tasks enabled (see apps/bff/CLAUDE.md).
UPSTREAM_ASYNC_IMAGE_TASKS=false
# Optional GPT Image 2 Responses main model, e.g. gpt-6-astra. Empty keeps native Images.
UPSTREAM_IMAGE_RESPONSES_MODEL=
# Chat model behind agent:chat. It must support tool calling on the gateway above. Required when
# the capability is on.
AGENT_CHAT_MODEL=
# Context window and per-response output cap of that model, from the upstream documentation.
AGENT_CHAT_CONTEXT_WINDOW=128000
AGENT_CHAT_MAX_TOKENS=8000
# Summary model used by context compaction. Empty follows AGENT_CHAT_MODEL; a cheap tier is fine.
AGENT_SUMMARY_MODEL=
# Image model the agent's image tool submits to. It must be an image model from channels.json.
# Empty takes the first image model there.
AGENT_IMAGE_MODEL=
# Video model the agent's video tool submits to. It must be a video model from channels.json.
# Empty takes the first video model there.
AGENT_VIDEO_MODEL=

# Channel secrets must match auth.secretRef in channels.json. Agnes uses its value directly.
OPENAI_API_KEY=replace-internal-openai-key
GEMINI_API_KEY=replace-internal-gemini-key
AGNES_API_KEY=replace-internal-agnes-key
GROK_API_KEY=replace-internal-grok-key
# Grok gateway address, matching baseUrlRef in channels.json. Must be https, since the channel key
# travels with every request; plain http is accepted only for loopback hosts. Include /v1. An unset,
# empty, or invalid value drops the grok-images channel. An empty GROK_API_KEY only warns.
GROK_BASE_URL=
ARK_API_KEY=replace-internal-ark-key
# Volcengine Ark gateway address, matching baseUrlRef in channels.json. Include the version segment
# (https://ark.cn-beijing.volces.com/api/v3). An unset, empty, or invalid value drops the ark-video
# channel. An empty ARK_API_KEY only warns.
ARK_BASE_URL=
# Google Veo key for the Gemini API, matching auth.secretRef in channels.json. The base URL is a
# literal there. An unset or empty value drops the veo-video channel from discovery.
VEO_API_KEY=replace-internal-veo-key

# Operations alerts (optional). A Feishu group bot webhook; leave empty and this deployment sends
# nothing at all, its own queue, backup and heartbeat alerts included. Deployments may share one
# address. It is a secret: anyone holding it can post to the group, so it lives only in this file,
# never in the repository.
OPS_ALERT_WEBHOOK_URL=
# Deployments sharing a host read the same disk. Exactly one of them should send the host alerts
# (disk, memory); the application alerts (queue, backup, heartbeat) are per deployment either way.
# The paid deployment on the same host sends the disk and memory alerts.
OPS_HOST_ALERTS=false
# Written into every alert so the group can tell deployments apart.
OPS_DEPLOYMENT_NAME=internal
