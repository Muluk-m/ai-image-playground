# Copy to a repository-external directory such as
# ~/.config/ai-image-playground/apps/image-playground-commercial/app.env.
# Replace every replace-* value and chmod 600 the result. Never commit the real file.

APP_IMAGE=ai-image-playground:local
INFRA_NETWORK_NAME=image-playground-infra
EDGE_NETWORK_NAME=image-playground-edge

# PostgreSQL roles are provisioned with `scripts/infra-compose.sh provision`.
# Admin credentials belong to the SELECT-only role.
APP_DATABASE_URL=postgresql://replace-commercial-app-user:replace-commercial-app-password@postgres:5432/replace-commercial-database
ADMIN_DATABASE_URL=postgresql://replace-commercial-admin-user:replace-commercial-admin-password@postgres:5432/replace-commercial-database

S3_ENDPOINT=http://minio:9000
S3_BUCKET=replace-commercial-bucket
S3_ACCESS_KEY_ID=replace-commercial-access-key
S3_SECRET_ACCESS_KEY=replace-commercial-secret-key

INTERNAL_API_TOKEN=replace-commercial-internal-service-token
CORS_ALLOWED_ORIGINS=https://commercial.example.com

ADMIN_PASSWORD=replace-commercial-operator-password
ADMIN_COOKIE_SECRET=replace-commercial-cookie-secret-at-least-32-characters

# The same static build is used by every deployment. Empty means same-origin nginx proxying.
BFF_ENABLED=true
BFF_BASE_URL=

# Place this optional file beside app.env. Present-but-invalid configuration fails startup.
OPERATOR_CONFIG_FILE=/run/operator/operator-config.json

# Provider keys are examples only. Keep only variables referenced by operator-config.json or channels.json.
OPENAI_API_KEY=replace-commercial-openai-key
GEMINI_API_KEY=replace-commercial-gemini-key
