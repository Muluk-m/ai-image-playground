# Copy to $XDG_CONFIG_HOME/ai-image-playground/pages.env on the workstation that releases the
# frontend (default $HOME/.config/ai-image-playground/pages.env), then replace every placeholder.
#
# scripts/pages-release.sh sources this file, so it is shell syntax: KEY=value, no `export`.
# Every key is prefixed with the edition: INTERNAL_ or PAID_. Keep only the editions this
# machine releases.

# --- internal (free) edition -------------------------------------------------------------
# Released from a checkout WITHOUT ./private: the overlay is compiled in by mere file presence,
# so scripts/pages-deploy.sh refuses a public bundle when that tree exists.

# Cloudflare Pages project name.
INTERNAL_PAGES_PROJECT=replace-internal-pages-project
# API origin baked into dist/runtime-config.json. Must share one registrable domain with
# INTERNAL_PUBLIC_ORIGIN: the Admin session cookie is Secure; SameSite=Lax.
INTERNAL_BFF_BASE_URL=https://replace-image-api.example.com
# Live frontend origin. Only used to poll /version.json after the upload.
INTERNAL_PUBLIC_ORIGIN=https://replace-image-playground.example.com
INTERNAL_CLOUDFLARE_ACCOUNT_ID=replace-internal-account-id
# Optional. An env file that sets CLOUDFLARE_API_TOKEN, sourced only for this release.
# Leave unset to release with wrangler's own OAuth login instead; the script then clears any
# CLOUDFLARE_API_TOKEN inherited from the shell.
#INTERNAL_CLOUDFLARE_TOKEN_FILE=/replace/path/to/internal-pages-token.env
# Optional. Copied into dist/op/ before the upload, published at /op/<file>. Public: anyone who
# knows the URL can read it.
#INTERNAL_EXTRA_ASSETS_DIR=/replace/path/to/internal-op-assets
# Optional. true makes open tabs show the update prompt for this release. The default is a
# silent release: running tabs pick the new bundle up on their next reload.
#INTERNAL_NOTIFY_UPDATE=true

# --- paid edition ------------------------------------------------------------------------
# Released from a checkout WITH ./private present and up to date.

PAID_PAGES_PROJECT=replace-paid-pages-project
PAID_BFF_BASE_URL=https://replace-paid-image-api.example.com
PAID_PUBLIC_ORIGIN=https://replace-paid-image-playground.example.com
PAID_CLOUDFLARE_ACCOUNT_ID=replace-paid-account-id
#PAID_CLOUDFLARE_TOKEN_FILE=/replace/path/to/paid-pages-token.env
#PAID_EXTRA_ASSETS_DIR=/replace/path/to/paid-op-assets
#PAID_NOTIFY_UPDATE=true

# Each release appends one line to $XDG_CONFIG_HOME/ai-image-playground/deployments.log, the
# same log scripts/vps-deploy.sh writes.
