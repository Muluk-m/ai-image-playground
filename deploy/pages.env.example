# Copy to $XDG_CONFIG_HOME/ai-image-playground/pages.env on the workstation that releases the
# frontend (default $HOME/.config/ai-image-playground/pages.env).
#
# scripts/pages-release.sh sources this file, so it is shell syntax: KEY=value, no `export`.
# Every key is prefixed with the edition. Keep only the editions this machine releases.
# All targets require the pinned private overlay.
# 一个项目、多个域名: the paid Pages project serves muvloom.online, the legacy paid domain and the
# enterprise domain. The INTERNAL_ keys below only describe that enterprise domain; there is no
# separate internal Pages project, account or token any more.

# Enterprise domain, an https:// origin served by the paid project. It gets a host-scoped noindex
# header and is polled by CI once the custom domain points at the paid project.
INTERNAL_PUBLIC_ORIGIN=https://replace-image-playground.example.com
# Its first-party API origin, merged into the paid runtime-config baseUrlsByOrigin map. Must
# share one registrable domain with INTERNAL_PUBLIC_ORIGIN: SameSite=Lax session cookies do not
# support pointing the enterprise site directly at the paid site's cross-site API hostname.
# Set both keys or neither.
INTERNAL_BFF_BASE_URL=https://replace-image-api.example.com

PAID_PAGES_PROJECT=replace-paid-pages-project
PAID_BFF_BASE_URL=https://replace-paid-image-api.example.com
# Optional JSON map when the same Pages project also serves a legacy frontend domain. The
# enterprise domain above is added automatically; do not list it here with a different API.
# Keep each site's API on its original registrable domain so existing host-only sessions work.
#PAID_BFF_BASE_URLS_BY_ORIGIN='{"https://legacy.example.net":"https://api.legacy.example.net"}'
PAID_PUBLIC_ORIGIN=https://replace-paid-image-playground.example.com
PAID_CLOUDFLARE_ACCOUNT_ID=replace-paid-account-id
#PAID_CLOUDFLARE_TOKEN_FILE=/replace/path/to/paid-pages-token.env
#PAID_EXTRA_ASSETS_DIR=/replace/path/to/paid-op-assets
#PAID_NOTIFY_UPDATE=true

# Paid Admin frontend. It shares the paid Cloudflare account and private overlay, but publishes
# a separate Pages project and talks only to the VPS Admin API.
ADMIN_PAGES_PROJECT=muvloom-admin
ADMIN_BFF_BASE_URL=https://admin-api.muvloom.online
ADMIN_PUBLIC_ORIGIN=https://admin.muvloom.online
ADMIN_CLOUDFLARE_ACCOUNT_ID=replace-paid-account-id
#ADMIN_CLOUDFLARE_TOKEN_FILE=/replace/path/to/paid-pages-token.env

# The test environment (docs/deploy/test-environment.md). Its own Pages project and its own
# domain, in the same Cloudflare account as the paid site; it ships the paid bundle, so the
# release needs ./private just like PAID_ does.
TEST_PAGES_PROJECT=muvloom-test
# A dedicated test backend is mandatory; release refuses production or unknown endpoints.
TEST_BFF_BASE_URL=https://test-api.muvloom.online
TEST_PUBLIC_ORIGIN=https://test.muvloom.online
TEST_CLOUDFLARE_ACCOUNT_ID=replace-paid-account-id
#TEST_CLOUDFLARE_TOKEN_FILE=/replace/path/to/paid-pages-token.env
# TEST_EXTRA_ASSETS_DIR and TEST_NOTIFY_UPDATE are deliberately left unset: the test site
# publishes no operator assets and must never prompt production tabs to update.
