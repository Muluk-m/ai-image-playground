# Copy this file outside the repository, restrict its permissions, and replace every placeholder.
# The helper defaults to $XDG_CONFIG_HOME/ai-image-playground/infra.env
# (or $HOME/.config/ai-image-playground/infra.env when XDG_CONFIG_HOME is unset).

INFRA_NETWORK_NAME=replace-with-private-network-name
INFRA_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

POSTGRES_DB=replace-with-database-name
POSTGRES_USER=replace-with-bootstrap-user
POSTGRES_PASSWORD=replace-with-strong-postgres-password

MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
# One unique bucket per deployment. Use comma-separated S3 bucket names without spaces.
MINIO_BUCKET_NAMES=replace-with-first-deployment-bucket,replace-with-second-deployment-bucket
