# Copy this file outside the repository, restrict its permissions, and replace every placeholder.
# The helper defaults to $XDG_CONFIG_HOME/ai-image-playground/infra.env
# (or $HOME/.config/ai-image-playground/infra.env when XDG_CONFIG_HOME is unset).

INFRA_NETWORK_NAME=image-playground-infra

POSTGRES_DB=replace-with-database-name
POSTGRES_USER=replace-with-bootstrap-user
POSTGRES_PASSWORD=replace-with-strong-postgres-password
# Provision one database deployment at a time with `scripts/infra-compose.sh provision`.
# Override these seven PostgreSQL values and rerun for each additional deployment.
POSTGRES_APP_DATABASE=replace-with-deployment-database
POSTGRES_MIGRATOR_USER=replace-with-deployment-migrator
POSTGRES_MIGRATOR_PASSWORD=replace-with-deployment-migrator-password
POSTGRES_APP_USER=replace-with-deployment-writer
POSTGRES_APP_PASSWORD=replace-with-deployment-writer-password
POSTGRES_ADMIN_USER=replace-with-deployment-readonly-user
POSTGRES_ADMIN_PASSWORD=replace-with-deployment-readonly-password
