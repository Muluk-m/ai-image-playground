# Copy to a repository-external directory such as
# ~/.config/ai-image-playground/apps/image-playground-paid/app.env.
# Replace every replace-* value and chmod 600 the result. Never commit the real file.

APP_IMAGE=ai-image-playground:local
INFRA_NETWORK_NAME=image-playground-infra

# PostgreSQL roles are provisioned with `scripts/infra-compose.sh provision`.
# The schema-owner credential lives only in the sibling migrate.env.
# APP_DATABASE_URL is DML-only; Admin credentials belong to the SELECT-only role.
# The same application role writes tasks and billing rows in one transaction.
APP_DATABASE_URL=postgresql://replace-paid-app-user:replace-paid-app-password@postgres:5432/replace-paid-database
# The daily pg-backup sidecar reuses this SELECT-only credential for pg_dump.
ADMIN_DATABASE_URL=postgresql://replace-paid-admin-user:replace-paid-admin-password@postgres:5432/replace-paid-database

# Cloudflare R2, S3-compatible. Leave the region unset: R2 accepts only `auto`.
# A different Cloudflare account and a dedicated bucket, so the prefix stays empty.
S3_ENDPOINT=https://replace-with-personal-account-id.r2.cloudflarestorage.com
S3_BUCKET=replace-with-paid-deployment-bucket
S3_KEY_PREFIX=
S3_ACCESS_KEY_ID=replace-with-paid-r2-access-key
S3_SECRET_ACCESS_KEY=replace-with-paid-r2-secret-key

INTERNAL_API_TOKEN=replace-paid-internal-service-token
CORS_ALLOWED_ORIGINS=https://image.nainma.online

# Both apply only to the reverse-proxy layout of README options 2 and 3, where nginx fronts the
# stack instead of cloudflared. Uncomment there; leave commented for the tunnel.
# CLIENT_IP_SOURCE=x-forwarded-for
# APP_INGRESS_MODE=full

# Worker health is based on successful queue polls. Keep the stale threshold at least three polls.
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEALTH_STALE_AFTER_MS=10000

ADMIN_PASSWORD=replace-paid-operator-password
ADMIN_COOKIE_SECRET=replace-paid-cookie-secret-at-least-32-characters

# Read only by the optional nginx `web` service. The Cloudflare Pages bundle gets these two
# values from scripts/pages-deploy.sh instead.
BFF_ENABLED=true
BFF_BASE_URL=https://api.nainma.online

# Optional third-party login. A provider appears on the login page only when both of its values
# are set. New subjects are provisioned as new accounts; they never merge into a password account
# with the same address, and they need `accounts:self-register` to stay enabled.
# AUTH_PUBLIC_ORIGIN is the origin registered as the provider redirect base; leave it unset only
# when the BFF sees its own public host. AUTH_FRONTEND_ORIGIN defaults to the first CORS origin.
AUTH_PUBLIC_ORIGIN=https://api.nainma.online
AUTH_FRONTEND_ORIGIN=https://image.nainma.online
# Redirect URI to register: <AUTH_PUBLIC_ORIGIN>/api/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Redirect URI to register: <AUTH_PUBLIC_ORIGIN>/api/auth/oauth/feishu/callback
OAUTH_FEISHU_APP_ID=
OAUTH_FEISHU_APP_SECRET=
# Feishu returns no email without this scope, and requesting a scope the app was never granted
# fails the whole authorization. Set it only after granting contact:user.email:readonly.
OAUTH_FEISHU_SCOPE=

# Place this optional file beside app.env. Present-but-invalid configuration fails startup.
OPERATOR_CONFIG_FILE=/run/operator/operator-config.json

# Standard OpenAI/Gemini channels use one shared gateway. Do not include /v1 in this URL.
UPSTREAM_BASE_URL=https://replace-with-paid-upstream-gateway
UPSTREAM_API_KEY=replace-paid-upstream-key
# Optional provider-specific gateway credentials override UPSTREAM_API_KEY.
UPSTREAM_OPENAI_API_KEY=
UPSTREAM_GEMINI_API_KEY=

# Channel secrets must match auth.secretRef in channels.json. Agnes uses its value directly.
OPENAI_API_KEY=replace-paid-openai-key
GEMINI_API_KEY=replace-paid-gemini-key
AGNES_API_KEY=replace-paid-agnes-key
