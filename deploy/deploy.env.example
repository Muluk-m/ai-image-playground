# Copy to $XDG_CONFIG_HOME/ai-image-playground/deploy.env on the VPS
# (default $HOME/.config/ai-image-playground/deploy.env).
#
# scripts/vps-deploy.sh sources this file, so it is shell syntax: KEY=value, no `export`.
# Every key is optional; the values below are the defaults.

# Compose project name of the internal (free) deployment.
INTERNAL_PROJECT=image-playground-internal
# Moving alias for its image. The rollout runs the commit-qualified tag built beside it,
# <INTERNAL_IMAGE>-<public sha7>.
INTERNAL_IMAGE=ai-image-playground:vps-main

# Compose project name of the paid deployment.
PAID_PROJECT=image-playground-paid
# Moving alias for its image. The rollout runs <PAID_IMAGE>-<public sha7>-<private sha7>.
PAID_IMAGE=ai-image-playground:paid

# How many commit-qualified images to keep per edition as rollback targets. The image a container
# still runs is always kept on top of these.
DEPLOY_KEEP_IMAGES=5
# Refuse to build with less than this many gigabytes free where Docker keeps its data.
# PostgreSQL shares that filesystem, so a build that fills it is an outage.
DEPLOY_MIN_FREE_GB=8
