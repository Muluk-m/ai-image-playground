# PAID_* names are live muvloom resource identifiers; see docs/deploy/image-release.md.
# Copy to $XDG_CONFIG_HOME/ai-image-playground/deploy.env on the VPS
# (default $HOME/.config/ai-image-playground/deploy.env).
#
# scripts/vps-deploy.sh sources this file, so it is shell syntax: KEY=value, no `export`.
# Every key is optional; the values below are the defaults.

# Compose project name of the muvloom deployment.
PAID_PROJECT=image-playground-paid
# Moving alias for its image. The rollout runs <PAID_IMAGE>-<public sha12>-<private sha12>.
PAID_IMAGE=ai-image-playground:paid

# The test target is deliberately fixed in the receiver: image-playground-test /
# ai-image-playground:test. It cannot be redirected using this environment file.

# How many commit-qualified images to keep per environment as rollback targets. The image a
# container still runs is always kept on top of these. Historical multi-image generations
# exhausted the 50 GiB production disk and blocked rollout on DEPLOY_MIN_FREE_GB.
DEPLOY_KEEP_IMAGES=2
# Refuse to load images below this free-space reserve (GiB).
DEPLOY_MIN_FREE_GB=8

# Environments whose executors use the shared EdgeTAM segmenter (deploy/segmenter, one container,
# versioned by deploy/segmenter/VERSION and replaced only from main). Allowed values: paid, test.
# A listed environment is attached on its next deploy. Production is off until Nain approves
# (see deploy/segmenter/README.md); then: SEGMENTER_EDITIONS="paid test".
SEGMENTER_EDITIONS=test
