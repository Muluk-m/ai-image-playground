# Copy to $XDG_CONFIG_HOME/ai-image-playground/deploy.env on the VPS
# (default $HOME/.config/ai-image-playground/deploy.env), then adjust.
#
# scripts/vps-deploy.sh sources this file, so it is shell syntax: KEY=value, no `export`.
# Every key is optional; the values below are the defaults baked into the script. The file
# exists so nothing environment-specific has to be edited into the script itself.

# Internal (free) deployment: the Compose project name that scripts/app-compose.sh drives, and
# the moving image tag the build writes.
INTERNAL_PROJECT=image-playground-internal
INTERNAL_IMAGE=ai-image-playground:vps-main

# Paid deployment, built with the ./private overlay compiled in.
PAID_PROJECT=image-playground-paid
PAID_IMAGE=ai-image-playground:paid

# Each build is also tagged with the commits it came from, and the rollout runs that tag:
#   internal  <INTERNAL_IMAGE>-<public sha7>
#   paid      <PAID_IMAGE>-<public sha7>-<private sha7>
# Those commit-qualified tags are what `scripts/app-compose.sh rollback <project> <tag>` needs,
# so keep a few of them on the host rather than pruning after every deploy.

# Not set here, but read from the same configuration directory:
#   apps/<project>/app.env        the application environment (deploy/app.*.env.example)
#   apps/<project>/migrate.env    the schema-owner credential (deploy/migrate.env.example)
#   secrets/private-repo-token    a GitHub token with read access to the private overlay
#                                 repository, used to fast-forward ./private; chmod 600.
#                                 Without it the script falls back to a plain `git pull`.
#   deployments.log               one appended line per deploy, written by the script.
