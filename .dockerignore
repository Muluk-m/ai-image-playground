# 构建上下文过滤 —— allowlist：先全禁，再逐条放行。
#
# 为什么不是 denylist：Dockerfile 的 runtime stage 直接从上下文 `COPY apps/bff` /
# `COPY packages/db` / `COPY packages/shared`，而本仓库是 public + MIT。denylist 漏一条
# 就是把 operator 私钥烤进公开镜像，且**静默无声**；allowlist 漏一条只会让构建当场失败。
# 两种漏法都会发生，选失败会喊出来的那一侧。
#
# 因此这里不再需要「往 .gitignore 加一条就同步加一条」的人工同步约定 —— gitignored
# 文件默认就进不来。加新的构建期文件时，构建会因为找不到它而失败，那时来补一行。
#
# 注意：`*` 只匹配顶层；靠下面的 `!` 逐层放行。最后一条匹配的规则生效，所以文件末尾
# 的 deny 会覆盖上面的 `!`。

*

# ── 根 manifest（deps stage 按文件名 COPY）─────────────────────────
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!tsconfig.base.json
# MIT 产物随镜像分发，许可证要跟着走
!LICENSE

# ── apps 构建输入 ─────────────────────────────────────────────────
!apps/*/package.json
!apps/*/tsconfig*.json
!apps/*/src
!apps/*/public
!apps/*/scripts
# 按后缀放行 Vite 的 HTML 入口；漏掉入口会在 Rollup 构建时报错。
!apps/*/*.html
# 官网预渲染与静态合包的构建期入口。
!apps/website/compose.mjs
!apps/website/seo.ts
!apps/website/imageSizes.ts
!apps/*/vite.config.ts
# tailwind.config.js / postcss.config.js
!apps/*/*.config.js
!apps/*/components.json
!apps/web/conversation-cache.config.json
!apps/*/drizzle.config.ts
!apps/admin/server
!apps/admin/contracts.ts
!apps/bff/channels.json
# 智能体技能目录：`SKILL.md` 与附属文件是运行时读盘的，不进模块图，
# 漏掉这一行镜像照样构建成功、容器照样起得来，只是一条技能都没有。
!apps/bff/skills


# ── packages 构建输入 ─────────────────────────────────────────────
!packages/*/package.json
!packages/*/tsconfig*.json
!packages/*/src
!packages/*/drizzle*.config.ts
!packages/*/drizzle
!packages/db/drizzle-billing

# ── Runtime configuration and entrypoints ─────────────────────────
!deploy/nginx.conf
!deploy/nginx.api-only.conf
!deploy/nginx.proxy.conf
# 配置中心（ADR 0035）的部署描述：只有非密钥配置，密钥在 Secrets Store。
!deploy/deployments/prod.json
!deploy/deployments/test.json
!deploy/host.json
!scripts/docker-entrypoint.sh
!scripts/check-dependencies.ts
!scripts/release-router.ts
!scripts/test-guard.ts

# ── 上面 `!` 放行的目录里仍有 gitignored 兄弟，重新排除 ────────────
# operator 的部署配置：vite 会把 public/** 原样复制进 dist，绝不能从宿主机带进来
apps/web/public/runtime-config.json
apps/web/public/cli/bin
# 构建期自己生成（apps/web/src/generated/heroSeed.json）
**/generated
**/node_modules
**/dist
# 技能效果验证的测试输入与评分记录只给仓库里的验证流程用，不进镜像。
apps/bff/skills/*/*/verification

# CLI static binaries are cross-compiled in the `cli-dist` builder stage and copied into
# `apps/web/public/cli/bin`; Go source and module cache never enter the runtime image.
!cli-go/
!cli-go/go.mod
!cli-go/go.sum
!cli-go/cmd/
!cli-go/cmd/**
!cli-go/internal/
!cli-go/internal/**
cli-go/dist
cli-go/muvloom
cli-go/muvloom.exe
!apps/web/workbuddy-skill/
!apps/web/workbuddy-skill/**
!apps/web/doubao-skill/
!apps/web/doubao-skill/**
