#!/usr/bin/env bash
# 推送前的本地快检：只查这次推送改到的东西，几秒到几十秒，省得等 CI 跑几分钟才看到 lint / 类型错。
# 它不替代 CI（CI 仍然全量跑）。跳过：git push --no-verify，或 AIP_PRE_PUSH=skip；
# 只跳类型检查：AIP_PRE_PUSH=lint。pnpm install 的 prepare 自动设置 core.hooksPath（CI 和已有自定义 hooksPath 除外）。
# 有 test-guard constrained 标记的机器默认只跑 lint，typecheck 交给远端；AIP_PRE_PUSH=full 强制本地跑。
set -euo pipefail

constrained="${XDG_CONFIG_HOME:-$HOME/.config}/test-guard/constrained"
default_mode=full
[ -e "$constrained" ] && default_mode=lint
mode="${AIP_PRE_PUSH:-$default_mode}"
[ "$mode" = skip ] && exit 0

if [ ! -d node_modules ]; then
  echo "pre-push: 没有 node_modules，跳过本地检查（先 pnpm install）。" >&2
  exit 0
fi

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
base=""
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # 删分支，不用查
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: ${local_ref} 不是当前 HEAD，不做本地检查，由 CI 把关。" >&2
    continue
  fi
  b=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  [ -n "$b" ] && base="$b"
done
[ -z "$base" ] && exit 0

files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git diff --name-only -z --diff-filter=ACMR "$base" "$head")
[ "${#files[@]}" -eq 0 ] && exit 0

echo "pre-push: biome 检查 ${#files[@]} 个改动文件（基于 ${base:0:9}）…" >&2
pnpm exec biome check --no-errors-on-unmatched --files-ignore-unknown=true "${files[@]}"
bun run scripts/check-arch-boundaries.ts
bun run scripts/check-adr-numbers.ts
bun run scripts/check-i18n-keys.ts
bun run scripts/check-design.ts
node scripts/check-migrations.mjs

if [ "$mode" != lint ]; then
  echo "pre-push: 受影响包的 typecheck（turbo 缓存命中时很快）…" >&2
  TURBO_SCM_BASE="$base" TURBO_SCM_HEAD="$head" pnpm exec turbo run typecheck --affected --output-logs=errors-only
fi
