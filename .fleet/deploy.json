{
  "$schema": "https://storage.sitepower.com/fleet/deploy.schema.json",
  "version": 1,
  "build": [
    "docker build --tag ai-image-playground:local ."
  ],
  "services": [
    {
      "name": "image-playground-infra",
      "targets": [
        "macmini"
      ],
      "watch": [
        "deploy/compose.infra.yaml",
        "deploy/infra.env.example"
      ],
      "run": {
        "kind": "compose",
        "file": "deploy/compose.infra.yaml",
        "project": "image-playground-infra",
        "build": false,
        "wait": true
      }
    },
    {
      "name": "image-playground-personal",
      "targets": [
        "macmini"
      ],
      "watch": [
        "Dockerfile",
        ".dockerignore",
        "deploy/compose.app.yaml",
        "deploy/nginx.conf",
        "scripts/docker-entrypoint.sh",
        "scripts/check-dependencies.ts",
        "apps/**",
        "packages/**",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "deps": [
        {
          "kind": "service",
          "name": "image-playground-infra"
        }
      ],
      "run": {
        "kind": "compose",
        "file": "deploy/compose.app.yaml",
        "project": "image-playground-personal",
        "build": false,
        "wait": true
      }
    },
    {
      "name": "image-playground-commercial",
      "targets": [
        "macmini"
      ],
      "watch": [
        "Dockerfile",
        ".dockerignore",
        "deploy/compose.app.yaml",
        "deploy/nginx.conf",
        "scripts/docker-entrypoint.sh",
        "scripts/check-dependencies.ts",
        "apps/**",
        "packages/**",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "deps": [
        {
          "kind": "service",
          "name": "image-playground-infra"
        }
      ],
      "run": {
        "kind": "compose",
        "file": "deploy/compose.app.yaml",
        "project": "image-playground-commercial",
        "build": false,
        "wait": true
      }
    }
  ]
}
