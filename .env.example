# 默认 API URL（OpenAI 兼容接口）
# VITE_DEFAULT_API_URL=https://api.openai.com/v1

# 标记部署是否提供同源 /api-proxy/ 反代（true/false）
# VITE_API_PROXY_AVAILABLE=true

# 灵感库远程 manifest URL（公开 raw JSON）。
# 缺省时使用硬编码 GitHub raw：qiliangjia/qlj-image-playground-inspirations/main/manifest.json
# 设置为空字符串可禁用远程拉取，只使用打包进 bundle 的内置 manifest。
# VITE_INSPIRATION_MANIFEST_URL=https://raw.githubusercontent.com/qiliangjia/qlj-image-playground-inspirations/main/manifest.json
