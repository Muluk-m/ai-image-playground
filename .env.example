# Copy to .env on the VPS and fill values. Do not commit .env.
# POSTGRES_PASSWORD must be URL-safe (A-Za-z0-9). It is interpolated into DATABASE_URL.

POSTGRES_PASSWORD=

# Cloudflare Pages origin, comma-separated. Do not use *.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=info

# channels.json auth.secretRef
OPENAI_API_KEY=
GEMINI_API_KEY=
AGNES_API_KEY=
GROK_API_KEY=

# Optional fallback gateway (no /v1). Direct channels use channels.json baseUrl.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_OPENAI_API_KEY=
UPSTREAM_GEMINI_API_KEY=

# Existing R2 bucket ai-images. Objects live under prefix image-playground/ only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-images

ADMIN_PASSWORD=
# HMAC cookie secret. At least 32 characters.
ADMIN_COOKIE_SECRET=

WORKER_POLL_INTERVAL_MS=1000
WORKER_OPENAI_CONCURRENCY=1
WORKER_GEMINI_CONCURRENCY=2
