        "secretRef": "SUB2API_GEMINI_FLASH_IMAGE_PREVIEW_KEY",
        "queryParam": "key"
      },
      "models": [
        {
          "id": "gemini-3.1-flash-image-preview",
          "label": "Gemini 3.1 Flash Image Preview",
          "capabilities": ["generate", "edit"]
        }
      ],
      "defaults": {
        "apiMode": "images",
        "timeout": 600,
