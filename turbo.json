{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // 包内 inputs 看不到仓库根，而 Bun 会在启动时自动加载根 .env —— 它能影响构建却
  // 不进任何 task 的哈希。放这里补上。
  "globalDependencies": [".env*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      // $TURBO_DEFAULT$ = 包内所有 git 追踪文件。不要退回手写白名单：上一版白名单漏了
      // tailwind.config.js / postcss.config.js，改主题不会让缓存失效，直接命中旧 dist。
      //
      // gitignored 文件对 $TURBO_DEFAULT$ 不可见，能影响构建的必须逐条显式列出：
      //   .env*                       —— vite build 读它填 import.meta.env
      //   public/runtime-config.json  —— vite 把 public/** 原样复制进 dist，
      //                                  operator 换版本时靠它区分部署形态
      //
      // 不需要 "env" 键：VITE_* 由 turbo 的 vite framework inference 自动进哈希，
      // 而 envMode 是 strict —— 未声明的变量会被从构建环境里剥掉，因此不可能出现
      // 「某个变量悄悄改变了产物却没进哈希」。真要读非 VITE_ 变量，在这里加 "env"。
      "inputs": ["$TURBO_DEFAULT$", ".env*", "public/runtime-config.json"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    }
  }
}
