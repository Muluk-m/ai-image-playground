{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "functions/**",
        "scripts/**",
        "config/**",
        "public/**",
        "index.html",
        "vite.config.*",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "functions/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "inputs": [
        "src/**",
        "functions/**",
        "scripts/**",
        "vitest.config.*",
        "tsconfig*.json",
        "package.json"
      ]
    }
  }
}
