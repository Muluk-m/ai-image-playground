{
  "name": "@image-playground/admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "dev": "vite",
    "predev": "pnpm routes:generate",
    "dev:server": "bun run --watch server/index.ts",
    "start": "bun run server/index.ts",
    "routes:generate": "bun run scripts/generate-route-tree.ts",
    "prebuild": "pnpm routes:generate",
    "build": "tsc -b && vite build",
    "pretypecheck": "pnpm routes:generate",
    "typecheck": "tsc -b",
    "pretest": "pnpm routes:generate",
    "pretest:client": "pnpm routes:generate",
    "test": "vitest run && bun run ../../scripts/run-bun-tests-isolated.ts src/__tests__/server",
    "test:server": "bun run ../../scripts/run-bun-tests-isolated.ts src/__tests__/server",
    "test:client": "vitest run"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@hookform/resolvers": "^5.7.1",
    "@image-playground/db": "workspace:*",
    "@image-playground/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-router": "^1.95.1",
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.0",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.85.0",
    "recharts": "2.15.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/router-generator": "^1.167.1",
    "@tanstack/router-vite-plugin": "^1.95.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "latest",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.5"
  }
}
