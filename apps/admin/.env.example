# Admin server env，cp 到 apps/admin/.env 后填值。**.env 不要进 git**。
#
# 强制必填（INTERNAL_API_TOKEN 仅在 accounts:login 能力开启时必填）：
#   ADMIN_PASSWORD            - 登录密码。建议 ≥ 16 chars。生成示例：
#                               openssl rand -base64 18
#   ADMIN_COOKIE_SECRET       - HMAC 签名 cookie 的 secret。**至少 32 chars**。
#                               生成示例：openssl rand -hex 32
#   INTERNAL_API_TOKEN        - Admin → BFF service credential for authenticated image reads and
#                               user writes. Use the same value as the BFF process.
#
# 可选（带默认值）：
#   PORT=37378                - admin server 监听端口
#   BFF_INTERNAL_URL=http://127.0.0.1:37377  - BFF 同机地址，用于反代图片端点
#   DATABASE_URL              - PostgreSQL URL for the Admin SELECT-only role.
#                               Do not reuse the BFF/worker writer credential.
#   ADMIN_FRONTEND_ORIGIN      - Pages 前端 origin；OAuth 完成后跳回这里。
#   ADMIN_CORS_ALLOWED_ORIGINS - 允许携带 cookie 调 admin API 的前端 origin；默认取
#                                ADMIN_FRONTEND_ORIGIN，本地开发可显式写 http://localhost:5174。
#
# 可选 Google 登录（三项齐全才生效，生效后密码登录被拒、ADMIN_PASSWORD 可留空）：
#   ADMIN_GOOGLE_CLIENT_ID       - Google OAuth 客户端 ID
#   ADMIN_GOOGLE_CLIENT_SECRET   - Google OAuth 客户端 secret
#   ADMIN_GOOGLE_ALLOWED_EMAILS  - 允许登录的邮箱，逗号分隔，忽略大小写
#   ADMIN_PUBLIC_ORIGIN          - Admin API 的对外 origin，用来拼 OAuth 回调地址；留空
#                                  则取请求自身 origin。
# 在 Google OAuth 客户端上把 <ADMIN_PUBLIC_ORIGIN>/api/auth/google/callback 登记为
# authorized redirect URI；登录完成后跳到 ADMIN_FRONTEND_ORIGIN。

ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=
INTERNAL_API_TOKEN=
PORT=37378
BFF_INTERNAL_URL=http://127.0.0.1:37377
DATABASE_URL=
ADMIN_FRONTEND_ORIGIN=http://localhost:5174
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:5174
ADMIN_PUBLIC_ORIGIN=
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_ALLOWED_EMAILS=
