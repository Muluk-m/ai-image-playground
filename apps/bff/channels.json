{
  "channels": [
    {
      "id": "openai-images",
      "kind": "openai-queue",
      "label": "OpenAI",
      "baseUrl": "https://api.openai.com/v1",
      "auth": {
        "type": "bearer",
        "secretRef": "OPENAI_API_KEY"
      },
      "models": [
        {
          "id": "gpt-image-2",
          "label": "GPT Image 2",
          "capabilities": ["generate", "edit", "mask", "quality", "n", "moderation"]
        }
      ],
      "defaults": {
        "apiMode": "images",
        "timeout": 600
      },
      "allowedPaths": ["images/generations", "images/edits"]
    },
    {
      "id": "gemini-flash-image",
      "kind": "gemini-queue",
      "label": "Gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "auth": {
        "type": "query-key",
        "secretRef": "GEMINI_API_KEY",
        "queryParam": "key"
      },
      "models": [
        {
          "id": "gemini-3.1-flash-image",
          "label": "Gemini 3.1 Flash Image",
          "capabilities": ["generate", "edit", "size"]
        }
      ],
      "defaults": {
        "apiMode": "images",
        "timeout": 600
      },
      "allowedPaths": ["models/gemini-3.1-flash-image:generateContent"]
    },
    {
      "id": "agnes-images",
      "kind": "openai-queue",
      "label": "Agnes AI",
      "baseUrl": "https://apihub.agnes-ai.com/v1",
      "auth": {
        "type": "bearer",
        "secretRef": "AGNES_API_KEY"
      },
      "models": [
        {
          "id": "agnes-image-2.1-flash",
          "label": "Agnes Image 2.1 Flash",
          "capabilities": ["generate", "edit", "size"]
        }
      ],
      "defaults": {
        "apiMode": "images",
        "timeout": 600
      },
      "allowedPaths": ["images/generations"]
    },
    {
      "id": "grok-images",
      "kind": "openai-queue",
      "label": "Grok Imagine Image",
      "baseUrlRef": "GROK_BASE_URL",
      "auth": {
        "type": "bearer",
        "secretRef": "GROK_API_KEY"
      },
      "models": [
        {
          "id": "grok-imagine-image",
          "label": "Grok Imagine Image 1.0",
          "capabilities": ["generate", "edit", "n"]
        },
        {
          "id": "grok-imagine-image-2.0",
          "label": "Grok Imagine Image 2.0",
          "capabilities": ["generate", "edit", "n", "quality"]
        }
      ],
      "defaults": {
        "apiMode": "images",
        "timeout": 600,
        "responseFormatB64Json": true,
        "asyncTasks": true
      },
      "allowedPaths": ["images/generations", "images/edits"]
    },
    {
      "id": "grok-video",
      "kind": "openai-queue",
      "label": "Grok Imagine Video",
      "baseUrlRef": "GROK_BASE_URL",
      "auth": {
        "type": "bearer",
        "secretRef": "GROK_API_KEY"
      },
      "models": [
        {
          "id": "grok-imagine-video",
          "label": "Grok Imagine Video",
          "media": "video",
          "capabilities": ["generate", "duration", "aspect_ratio", "resolution", "first_frame"]
        }
      ],
      "defaults": {
        "timeout": 600,
        "asyncTasks": true
      },
      "allowedPaths": ["videos/generations", "videos/extensions", "videos/edits", "videos"]
    },
    {
      "id": "agnes-video",
      "kind": "openai-queue",
      "label": "Agnes AI Video",
      "baseUrl": "https://apihub.agnes-ai.com/v1",
      "auth": {
        "type": "bearer",
        "secretRef": "AGNES_API_KEY"
      },
      "models": [
        {
          "id": "agnes-video-2.5-flash",
          "label": "Agnes Video 2.5 Flash",
          "media": "video",
          "capabilities": [
            "generate",
            "duration",
            "aspect_ratio",
            "resolution",
            "first_frame",
            "last_frame"
          ]
        }
      ],
      "defaults": {
        "timeout": 600,
        "asyncTasks": true
      },
      "allowedPaths": ["videos", "agnesapi"]
    },
    {
      "id": "ark-video",
      "kind": "openai-queue",
      "label": "Seedance Video",
      "baseUrlRef": "ARK_BASE_URL",
      "auth": {
        "type": "bearer",
        "secretRef": "ARK_API_KEY"
      },
      "models": [
        {
          "id": "doubao-seedance-2-0-mini-260615",
          "label": "Seedance 2.0 Mini",
          "media": "video",
          "capabilities": [
            "generate",
            "duration",
            "aspect_ratio",
            "resolution",
            "first_frame",
            "last_frame"
          ]
        }
      ],
      "defaults": {
        "timeout": 600,
        "asyncTasks": true
      },
      "allowedPaths": ["contents/generations/tasks"]
    },
    {
      "id": "veo-video",
      "kind": "openai-queue",
      "label": "Veo",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "requiresSecret": true,
      "auth": {
        "type": "bearer",
        "secretRef": "VEO_API_KEY"
      },
      "models": [
        {
          "id": "veo-3.1-fast-generate-preview",
          "label": "Veo 3.1 Fast",
          "media": "video",
          "capabilities": ["generate", "duration", "aspect_ratio", "resolution", "first_frame"]
        },
        {
          "id": "veo-3.1-lite-generate-preview",
          "label": "Veo 3.1 Lite",
          "media": "video",
          "capabilities": ["generate", "duration", "aspect_ratio", "resolution", "first_frame"]
        }
      ],
      "defaults": {
        "timeout": 600,
        "asyncTasks": true
      },
      "allowedPaths": ["models"]
    }
  ]
}
