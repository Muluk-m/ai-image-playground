# BFF 监听端口（默认 37377，不撞 vite/wrangler/常见服务）
PORT=37377

# sub2api 本机地址（含协议 + host + port，不含 /v1 后缀）
# 形如 http://localhost:8080 或 http://127.0.0.1:8000
# BFF 会按 OpenAI 兼容（/v1/images/...）/ Gemini (/v1beta/models/...) 拼后缀
SUB2API_BASE_URL=http://localhost:8080
SUB2API_API_KEY=sk-xxx
# 可选：按 provider 分别指定 key（优先于 SUB2API_API_KEY）
SUB2API_OPENAI_API_KEY=
SUB2API_GEMINI_API_KEY=

# SQLite 文件路径（相对 apps/bff 或绝对）
DATABASE_URL=../../artifacts/image-playground.sqlite

# 允许的前端 origin（CORS）。多个用逗号分隔，`*` 允许全部。
# 注意：Origin 值不含末尾斜杠或路径。本地开发可加 http://localhost:5173。
# CORS 仅在浏览器侧生效（preflight 拦截跨源 fetch）；curl / 伪造 Origin 的请求
# 仍能调通。真正的安全边界靠 BFF URL 私有 + 上游站点的 CF Access 校验组合形成。
CORS_ALLOWED_ORIGINS=https://image-playground.qiliangjia.one,http://localhost:5173

# 前端静态文件目录（相对 apps/bff 或绝对路径）。留空则不 serve 静态文件。
# 同机部署时指向 apps/web/dist，BFF 同时提供 API + 前端。
# STATIC_DIR=../web/dist
