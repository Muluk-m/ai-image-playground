# BFF 监听端口（默认 37377，不撞 vite/常见本地服务）
PORT=37377

# 可选用户登录。个人部署保持 false；经营部署设 true。
# 注意：前端显示开关由 Docker entrypoint 写入 runtime-config.json，但真正的访问控制
# 由 BFF 读取这里的同名变量执行。
AUTH_ENABLED=false
# Admin → BFF service credential. Required when AUTH_ENABLED=true; keep the real value outside git.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=
# Optional operator configuration. A missing file keeps every capability closed; a present invalid
# file stops BFF startup. Start from operator-config.example.json and mount the real file externally.
# OPERATOR_CONFIG_FILE=/run/operator/operator-config.json


# 上游 API 地址（含协议 + host + port，不含 /v1 后缀）
# - 直连 OpenAI: https://api.openai.com
# - 自建反代:    http://localhost:8080
# BFF 按 OpenAI 兼容（/v1/images/…）/ Gemini（/v1beta/models/…）拼后缀
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_API_KEY=sk-xxx
# 可选：按 provider 分别指定 key（优先于 UPSTREAM_API_KEY）
UPSTREAM_OPENAI_API_KEY=
UPSTREAM_GEMINI_API_KEY=

# channels.json 路径覆盖（默认 apps/bff/channels.json）
# CHANNELS_FILE=/etc/ai-image-playground/channels.json

# 内置 channel 的 secret env — 必须匹配 channels.json 里各 channel 的 auth.secretRef
# 示例（按你 channels.json 实际配置填）：
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Agnes 直连上游（baseUrl 在 channels.json 维护，不走 UPSTREAM_BASE_URL 网关）：
AGNES_API_KEY=

# PostgreSQL URL. BFF and worker need the deployment writer role.
DATABASE_URL=postgresql://image_playground_app:replace-with-password@localhost:5432/image_playground

# S3-compatible object storage. Required by BFF submit, worker, image, and cleanup paths.
# Keep credentials outside git. MinIO example endpoint: http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=image-playground
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 允许的前端 origin（CORS）。多个用逗号分隔，`*` 允许全部。
# 注意：CORS 仅在浏览器侧生效（preflight 拦截跨源 fetch）；curl / 伪造 Origin 的请求
# 仍能调通。真正的安全边界靠 BFF URL 不公开 + 反向代理的 access policy 组合形成。
# 生产请收紧到具体 origin，不要保留 `*`。
CORS_ALLOWED_ORIGINS=*

# 前端静态文件目录（相对 apps/bff 或绝对路径）。留空则不 serve 静态文件。
# 同机部署时指向 apps/web/dist，BFF 同时提供 API + 前端。
# STATIC_DIR=../web/dist
