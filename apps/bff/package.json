{
  "name": "@image-playground/bff",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:worker": "bun run --watch src/worker-index.ts",
    "start": "bun run src/index.ts",
    "start:worker": "bun run src/worker-index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "migrate:blobs": "bun run scripts/migrate-blobs.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@image-playground/db": "workspace:*",
    "@image-playground/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.3",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3"
  }
}
