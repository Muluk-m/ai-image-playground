{
  "channels": [
    {
      "id": "qlj-sub2api-gemini-flash-image-preview",
      "kind": "gemini",
      "label": "Gemini",
      "baseUrl": "https://sub2api.qiliangjia.one/v1beta",
      "auth": {
        "type": "query-key",
        "secretRef": "SUB2API_GEMINI_FLASH_IMAGE_PREVIEW_KEY",
        "queryParam": "key"
      },
      "models": [
        {
          "id": "gemini-3.1-flash-image-preview",
          "label": "Nano Banana 2 Preview",
          "capabilities": [
            "generate",
            "edit"
          ]
        }
      ],
      "defaults": {
        "apiMode": "images",
        "timeout": 600,
        "responseFormatB64Json": false
      },
      "allowedPaths": [
        "models/gemini-3.1-flash-image-preview:generateContent"
      ]
    },
    {
      "id": "qlj-sub2api-openai-gpt-image",
      "kind": "openai-compat",
      "label": "OpenAI",
      "baseUrl": "https://sub2api.qiliangjia.one/v1",
      "auth": {
        "type": "bearer",
        "secretRef": "SUB2API_OPENAI_KEY"
      },
      "models": [
        {
          "id": "gpt-image-2",
          "label": "GPT Image 2",
          "capabilities": [
            "generate",
            "edit"
          ]
        },
        {
          "id": "gpt-image-2-2026-04-21",
          "label": "GPT Image 2 (2026-04-21)",
          "capabilities": [
            "generate",
            "edit"
          ]
        }
      ],
      "defaults": {
        "apiMode": "images",
        "codexCli": true,
        "timeout": 600
      },
      "allowedPaths": [
        "images/generations",
        "images/edits"
      ]
    }
  ]
}