# Cloudflare Pages Functions secrets for local dev (`wrangler pages dev`).
# Copy to `.dev.vars` and fill in the values. `.dev.vars` is gitignored.
#
# Each variable name here MUST match an `auth.secretRef` in `config/channels.json`.
# Production secrets are configured in the Cloudflare Pages dashboard (Settings → Environment variables).

# qlj · Gemini 3.1 Flash Image (kind: gemini, auth: query-key)
SUB2API_GEMINI_FLASH_KEY=

# qlj · Gemini 3.1 Flash Image Preview (kind: gemini, auth: query-key)
SUB2API_GEMINI_FLASH_IMAGE_PREVIEW_KEY=

# qlj · sub2api OpenAI gpt-image (kind: openai-compat, auth: bearer)
SUB2API_OPENAI_KEY=
