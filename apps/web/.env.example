# 默认 API URL（OpenAI 兼容接口）
# VITE_DEFAULT_API_URL=https://api.openai.com/v1

# 标记部署是否提供同源 /api-proxy/ 反代（true/false）
# VITE_API_PROXY_AVAILABLE=true

# 灵感库远程 manifest URL。
# 缺省走同源静态资源 `./inspiration-manifest.json`（仓库 public/ 目录里，跟着 CF Pages 一起部署）。
# 团队希望脱离部署单独维护清单时，可指向 CDN / 公开 repo raw / gist。
# 空字符串禁用远程拉取，只用打包进 bundle 的 builtin.json。
# VITE_INSPIRATION_MANIFEST_URL=./inspiration-manifest.json

# Queue 模式 BFF channels（JSON 数组）。
# 部署在 mac mini 的 apps/bff 通过 cf tunnel 公开域名后，把它注入到这里。
# 注入的 channel 会跟 builtin-edge channels 平行出现在主界面模型下拉里，
# 通过 fal.ai-style 协议（submit → polling → fetch result）绕开 CF Edge 100s 超时。
# 详见 apps/bff/README.md。
# VITE_BFF_QUEUE_CHANNELS='[{"id":"qlj-bff-openai","kind":"openai-queue","label":"qlj BFF · OpenAI","bffBaseUrl":"https://bff.your-domain.com","models":[{"id":"gpt-image-2","label":"GPT Image 2"}],"defaults":{"apiMode":"images","timeout":600}}]'
